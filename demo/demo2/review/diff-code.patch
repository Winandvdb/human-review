+<script>
+// The 26 owners of the development seed (db/seed/R__seed.sql)
+const OWNERS = [
+  ['Kevin','McCallister','671 Lincoln Boulevard','Winnetka','8474461990','Axel'],
+  ['Harry','Potter','4 Privet Drive','Little Whinging','0119084455','Hedwig'],
+  ['Erwin','Schroedinger','Boltzmanngasse 5','Vienna','0131914920','Milton'],
+  ['Ștefan','Mureșan','12 Boltzmanngasse','Vienna','(0043)152634418','Basilisk'],
+  ['Łukasz','Śliwiński','ul. Floriańska 14','Kraków','+48124221357','Perdita, Pongo'],
+  ['Roger','Radcliff','27 Outer Circle','London','+442074860707','Reksio'],
+  ['Newt','Scamander','Diagon Alley','London','(0044)2079460001','Pickett'],
+  ['Alice','Liddell','Christ Church','Oxford','+441865276150','Cheshire, Dinah'],
+  ['Henry','Baskerville','Baskerville Hall','Dartmoor','(0044)1626832093','Baskerville'],
+  ['John','Dolittle','Oxenthorpe Road','Puddleby','+441803712345','Polynesia'],
+  ['George','Darling','14 Kensington Gardens','London','(0044)2079372121','Liza, Nana'],
+  ['Sam','Carraclough','Greenall Bridge','Yorkshire','+441943876543','Lassie'],
+  ['Beatrix','Potter','Hill Top Farm','Near Sawrey','(0044)1539436269','Mittens, Pickles'],
+  ['Long','Silver','Admiral Benbow Inn','Bristol','+441179293000','Captain Flint'],
+  ['Argus','Filch','Hogwarts Castle','Inverness','(0044)1463245678','Mrs Norris'],
+  ['Wallace','Wensleydale','62 West Wallaby Street','Wigan','+441942244466','Gromit, Hutch'],
+  ['Wendy','Darling','14 Kensington Gardens','London','(0044)2079372122','Toby'],
+  ['Rubeus','Hagrid','Gamekeepers Hut','Hogsmeade','+441463555111','Norbert'],
+  ['Hermione','Granger','Gryffindor Tower','Hogsmeade','(0044)1463555112','Crookshanks'],
+  ['Tom','Riddle','Malfoy Manor','Wiltshire','0119844321','Nagini'],
+  ['Tintin','Reporter','26 Rue du Labrador','Brussels','(0032)225112233','Snowy'],
+  ['Lady','Tremaine','Chateau Tremaine','Ile-de-France','0146203030','Jaq, Lucifer'],
+  ['Mister','Geppetto','Via dei Tessitori 7','Florence','+39055290383','Figaro'],
+  ['Alonso','Quixano','Campo de Montiel','La Mancha','(0034)926215566','Rocinante'],
+  ['Charles','Dickens',"Gad's Hill Place",'Higham','+441634406030','Grip'],
+  ['Sherlock','Holmes','221B Baker Street','London','(0044)2079351269','Toby of Lambeth'],
+].map(([first, last, address, city, telephone, pets], i) => ({id: i + 1, first, last, address, city, telephone, pets}));
+
+// Same orders the server will use (design.md → API contract), compared like the database collation
+const cmp = new Intl.Collator('en').compare;
+const ORDERS = {
+  name: (a, b) => cmp(a.first, b.first) || cmp(a.last, b.last) || a.id - b.id,
+  city: (a, b) => cmp(a.city, b.city) || cmp(a.first, b.first) || cmp(a.last, b.last) || a.id - b.id,
+};
+
+const params = new URLSearchParams(location.search);
+const state = {
+  lastName: params.get('lastName') || '',
+  sort: params.get('sort') || 'name',
+  dir: params.get('dir') || 'asc',
+  size: +(params.get('size') || 10),
+  page: +(params.get('page') || 0),
+};
+if (params.has('notes')) document.body.classList.add('notes');
+
+const $ = id => document.getElementById(id);
+const esc = s => s.replace(/[&<>"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c]));
+
+function render() {
+  const matches = OWNERS.filter(o => o.last.startsWith(state.lastName))
+    .sort((a, b) => (state.dir === 'asc' ? 1 : -1) * ORDERS[state.sort](a, b));
+  const pages = Math.max(1, Math.ceil(matches.length / state.size));
+  state.page = Math.min(state.page, pages - 1);
+  const from = state.page * state.size;
+  const shown = matches.slice(from, from + state.size);
+
+  $('lastName').value = state.lastName;
+  $('size').value = state.size;
+  $('ownersTable').style.display = matches.length ? '' : 'none';
+  $('noOwners').style.display = matches.length ? 'none' : '';
+  $('noOwners').textContent = `No owners with last name starting with "${state.lastName}"`;
+  $('rows').innerHTML = shown.map(o => `<tr>
+      <td class="ownerFullName"><a href="#">${esc(o.first)} ${esc(o.last)}</a></td>
+      <td>${esc(o.address)}</td><td>${esc(o.city)}</td><td>${esc(o.telephone)}</td>
+      <td>${o.pets.split(', ').map(esc).join('<br>')}</td></tr>`).join('');
+  $('range').textContent = `${from + 1} – ${from + shown.length} of ${matches.length}`;
+  $('first').disabled = $('prev').disabled = state.page === 0;
+  $('next').disabled = $('last').disabled = state.page >= pages - 1;
+  document.querySelectorAll('th.sortable').forEach(th => {
+    const active = th.dataset.key === state.sort;
+    th.classList.toggle('sorted', active);
+    th.querySelector('.arrow').textContent = active ? (state.dir === 'asc' ? '↑' : '↓') : '↕';
+  });
+  $('next').onclick = () => { state.page++; render(); };
+  $('last').onclick = () => { state.page = pages - 1; render(); };
+}
+
+function search() { state.lastName = $('lastName').value; state.page = 0; render(); }
+$('first').onclick = () => { state.page = 0; render(); };
+$('prev').onclick = () => { state.page--; render(); };
+$('size').onchange = e => { state.size = +e.target.value; state.page = 0; render(); };
+document.querySelectorAll('th.sortable').forEach(th => th.onclick = () => {
+  state.dir = state.sort === th.dataset.key && state.dir === 'asc' ? 'desc' : 'asc';
+  state.sort = th.dataset.key;
+  state.page = 0;
+  render();
+});
+render();
+</script>
+</body>
+</html>
